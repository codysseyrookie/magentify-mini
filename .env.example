# Liner Model API 설정
# LINER_API_KEY가 비어있으면 자동으로 기본 템플릿(폴백) 모드로 안전하게 동작합니다.
LINER_API_KEY=""
# LINER_BASE_URL: 공식 문서 확인 후 입력 (예: https://api.liner.com/v1 등 - 임의 가정 금지)
LINER_BASE_URL=""
# LINER_MODEL: 공식 문서 확인 후 입력 (모델명 - 임의 가정 금지)
LINER_MODEL=""

# 호출 제어
LINER_TIMEOUT_SEC=20
LINER_DAILY_LIMIT=200

# 데모 및 기본 설정
DEMO_MODE=1
REF_DATE_DEFAULT="2026-11-30"
DB_PATH="./data/app.db"
