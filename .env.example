# Liner API (필수: LINER_API_KEY). 값은 .env에만 넣고 저장소에 올리지 않는다.
LINER_API_KEY=
LINER_BASE_URL=
LINER_MODEL=
LINER_TIMEOUT_SEC=
LINER_SEARCH_TIMEOUT_SEC=
LINER_DAILY_LIMIT=

# 대체 공급자 (Liner 키가 없을 때만 사용)
GEMINI_API_KEY=

# 공개 API 보호 (선택, 기본값: 생성 40회/10분, 검색 20회/10분 per IP)
GUARD_GENERATE_PER_10MIN=
GUARD_NEWS_PER_10MIN=
